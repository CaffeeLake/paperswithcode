# Chat transport for the staging frontend.
# The UI itself is fail-closed and must be explicitly enabled for staging.
VITE_CHAT_ENABLED=1

# 1 = live: staging nginx routes /api/v1/chat/stream to the chat-enabled
# backend instance on 127.0.0.1:8001 (backend-chat-staging.service), admin-
# gated via auth_request. Requires an HF admin session (sign in on production;
# the .paperswithcode.co cookie carries over). Set to 0 to fall back to the
# scripted mock (frontend/src/lib/chatMock.ts).
VITE_CHAT_LIVE=1
# Pace provider deltas through the bounded client-side jitter buffer and batch
# visible updates to animation frames.
VITE_CHAT_SMOOTH_STREAMING=1

# Browser MCP App host. Deploy also sets this; keep it in the staging env file
# so older host tooling cannot bake the diagram iframe permanently off.
VITE_CHAT_MCP_APPS_HOST_ENABLED=1

# Admin-only paper-page trigger backed by the isolated :8001 staging API.
# Keep catalog-mutating actions hidden until they use an approved mediated
# production mutation path. Staging itself has read-only catalog access.
VITE_CODEX_ADD_EVALS_ENABLED=0
VITE_CODEX_ENRICH_PAPER_ENABLED=0
