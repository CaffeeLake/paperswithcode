[Unit]
Description=Papers With Code staging backend slot (%i)
Requires=paperswithcode-staging-backend@%i.socket
After=network-online.target postgresql.service postgresql@16-main.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=pwc-staging
Group=pwc-staging
WorkingDirectory=/srv/paperswithcode/environments/staging/slots/%i/release
EnvironmentFile=/etc/paperswithcode/staging.env
ExecStart=/usr/bin/python3 /usr/local/lib/paperswithcode-deploy/slot_launcher.py staging %i
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=660
KillSignal=SIGTERM
SyslogIdentifier=paperswithcode-staging-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/paperswithcode
ReadWritePaths=/var/lib/paperswithcode/staging /var/log/paperswithcode/staging
