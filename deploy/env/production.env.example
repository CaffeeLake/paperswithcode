PWC_ENVIRONMENT=production
PWC_FRONTEND_DIST_DIR=/srv/paperswithcode/environments/production/current/frontend-dist
PWC_RUNTIME_DATA_DIR=/var/lib/paperswithcode/production
PWC_CRON_LOG_DIR=/var/lib/paperswithcode/production/cron-logs
PWC_CRON_LOCK_DIR=/var/lib/paperswithcode/production/cron-locks
PWC_THUMBNAIL_CACHE_DIR=/var/lib/paperswithcode/shared/thumbnails
PWC_THUMBNAIL_TEMP_CACHE_DIR=/var/lib/paperswithcode/shared/thumbnails
PWC_CODEX_ADD_EVALS_SPOOL_DIR=/var/lib/paperswithcode/production/recovery-spool
PWC_CODEX_JOBS_NAMESPACE=your-hf-namespace
# PWC_CODEX_JOBS_TOKEN and PWC_CODEX_JOBS_OPENAI_API_KEY are required secrets.
PWC_CHAT_AGENT_CWD=/var/lib/paperswithcode/production/chat-agent
PWC_CHAT_RECOVERY_SPOOL_DIR=/var/lib/paperswithcode/production/chat-recovery-spool
PWC_SESSION_COOKIE_NAME=pwc_session
PWC_SESSION_COOKIE_DOMAIN=
PWC_SHARED_SESSION_COOKIE_NAME=pwc_shared_session
PWC_SHARED_SESSION_COOKIE_DOMAIN=.paperswithcode.co
PWC_SESSION_SIGNING_PRIVATE_KEY=replace-with-base64url-ed25519-private-key
PWC_SESSION_VERIFICATION_PUBLIC_KEY=replace-with-base64url-ed25519-public-key
PWC_AUTH_AUTHORITY_ORIGIN=https://paperswithcode.co
PWC_AUTH_RETURN_ORIGINS=https://paperswithcode.co,https://staging.paperswithcode.co
PWC_CHAT_ENABLED=false
PWC_CHAT_WEB_SEARCH_ENABLED=false
PWC_CHAT_PUBLIC_ADMISSION_ENABLED=false
PWC_CHAT_SANDBOX_ADMISSION_ENABLED=false
PWC_CHAT_TITLE_GENERATION_ENABLED=false
PWC_CHAT_TITLE_BILL_TO=
PWC_CHAT_DEEPSEEK_V4_FLASH_ROUTE=deepseek-ai/DeepSeek-V4-Flash-0731:fastest
PWC_CHAT_OPERATIONAL_ALERTS_ENABLED=false
PWC_CHAT_PROVIDER_ALERT_WINDOW_SECONDS=300
PWC_CHAT_PROVIDER_ALERT_MIN_FAILURES=5
PWC_CHAT_PROVIDER_ALERT_FAILURE_PERCENT=50
# Production chat remains dormant. A separately authorized activation must
# provision its own nielsr title credential, $25 title circuit, isolated Modal
# runtime, $75/$100/$250 sandbox circuit, 2-active-plus-1-blank capacity, and
# distinct alert destinations before enabling either admission control.
# Production OpenRouter is prohibited: no key, keyring, tracking secret, funded
# model, allowance API, percentage bar, or BYOK control may be configured.
PWC_CHAT_OPENROUTER_API_KEY=
PWC_CHAT_OPENROUTER_SERVER_FUNDED_ENABLED=false
PWC_CHAT_OPENROUTER_CREDENTIAL_KEYRING=
PWC_CHAT_OPENROUTER_USER_TRACKING_SECRET=
PWC_CATALOG_MUTATIONS_ENABLED=true
PWC_THUMBNAIL_MUTATIONS_ENABLED=false
PWC_CRON_ENABLED=true
PWC_DB_SEARCH_PATH=public
PWC_DB_HOST=localhost
PWC_DB_PORT=5432
PWC_DB_NAME=paperswithcode_hf
PWC_DB_USER=replace
PWC_DB_PASSWORD=replace
PWC_JWT_SECRET=replace
PWC_HF_OAUTH_CLIENT_ID=replace
PWC_HF_OAUTH_CLIENT_SECRET=replace
PWC_HF_OAUTH_CREDENTIAL_SECRET=replace-shared-with-staging
PWC_ADMIN_HF_USERNAMES=nielsr
PWC_ADMIN_HF_SUBJECTS=
PWC_CONTRIBUTOR_HF_SUBJECTS=
PWC_CONTRIBUTOR_DIRECT_EDITS_ENABLED=false
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
WEB_CONCURRENCY=2
