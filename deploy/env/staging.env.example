PWC_ENVIRONMENT=staging
PWC_FRONTEND_DIST_DIR=/srv/paperswithcode/environments/staging/current/frontend-dist
PWC_RUNTIME_DATA_DIR=/var/lib/paperswithcode/staging
PWC_CRON_LOG_DIR=/var/lib/paperswithcode/staging/cron-logs
PWC_CRON_LOCK_DIR=/var/lib/paperswithcode/staging/cron-locks
PWC_THUMBNAIL_CACHE_DIR=/var/lib/paperswithcode/shared/thumbnails
PWC_THUMBNAIL_TEMP_CACHE_DIR=/var/lib/paperswithcode/shared/thumbnails
PWC_CODEX_ADD_EVALS_WORK_DIR=/var/lib/paperswithcode/staging/codex-work
PWC_CODEX_ADD_EVALS_SPOOL_DIR=/var/lib/paperswithcode/staging/recovery-spool
PWC_CHAT_AGENT_CWD=/var/lib/paperswithcode/staging/chat-agent
PWC_CHAT_RECOVERY_SPOOL_DIR=/var/lib/paperswithcode/staging/chat-recovery-spool
PWC_SESSION_COOKIE_NAME=pwc_staging_session
PWC_SESSION_COOKIE_DOMAIN=
PWC_CHAT_ENABLED=true
PWC_CHAT_REQUIRE_AUTH=true
PWC_CATALOG_MUTATIONS_ENABLED=false
PWC_THUMBNAIL_MUTATIONS_ENABLED=false
PWC_CRON_ENABLED=false
PWC_DB_SEARCH_PATH=staging,public
PWC_DB_HOST=localhost
PWC_DB_PORT=5432
PWC_DB_NAME=paperswithcode_hf
PWC_DB_USER=pwc_staging
PWC_DB_PASSWORD=replace
PWC_JWT_SECRET=replace-different-from-production
PWC_PRODUCTION_JWT_FINGERPRINT=replace-with-sha256-only
PWC_HF_OAUTH_CLIENT_ID=replace
PWC_HF_OAUTH_CLIENT_SECRET=replace
PWC_ADMIN_HF_USERNAMES=nielsr
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8001
WEB_CONCURRENCY=1
